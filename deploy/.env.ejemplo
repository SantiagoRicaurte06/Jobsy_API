# Copiar a .env (que git ignora) y rellenar. Para generar claves:
#   openssl rand -base64 48

# Dominio del MID (registro DNS tipo A apuntando a la IP del servidor).
DOMINIO_API=api.tudominio.com
# Origen exacto del front, sin barra final. Varios: separados por coma.
URL_FRONT=https://jobsy.vercel.app

# Superusuario de Postgres: solo para administrar, las APIs no lo usan.
DB_CLAVE_ADMIN=
# Usuario con el que se conectan las 7 APIs (solo lee y escribe datos).
DB_USUARIO_APP=jobsy_app
DB_CLAVE_APP=

# Minimo 32 caracteres. Si cambia, todas las sesiones abiertas se invalidan.
MID_JWT_SECRETO=
# Clave compartida con la pasarela de pago (vacia mientras no haya pasarela).
MID_SECRETO_PASARELA=
