# Caddy saca y renueva solo el certificado HTTPS de DOMINIO_API (Let's
# Encrypt). Requisito: el DNS del dominio ya apunta a la IP del servidor y los
# puertos 80 y 443 estan abiertos.
{$DOMINIO_API} {
	encode gzip
	# Igual que maxuploadsize del MID (12 MB) con un margen para el resto del cuerpo.
	request_body {
		max_size 13MB
	}
	reverse_proxy mid:9090
}
